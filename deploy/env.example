# Copy to project root as `.env` before `docker compose up`
# cp deploy/env.example .env

# --- Django ---
DJANGO_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-long-random-string
DJANGO_ALLOWED_HOSTS=skidmosa.com,www.skidmosa.com,YOUR_VPS_IP
DJANGO_CORS_ORIGINS=https://skidmosa.com,https://www.skidmosa.com
VITE_ADMIN_PASSWORD=Skidmo123

# --- Postgres ---
POSTGRES_DB=skidmo
POSTGRES_USER=skidmo
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Site ---
VITE_SITE_URL=https://skidmosa.com

# --- Contact form SMTP (Gmail app password or your provider) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=skidmoksa@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=skidmoksa@gmail.com
SMTP_TO=skidmoksa@gmail.com
